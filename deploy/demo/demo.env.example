# /var/www/stickercontrol-demo/.env (PLANTILLA). Permisos 600, dueno stickerdemo.
# Secretos NUEVOS, generados en el servidor. Nunca reutilizar los de Skillgames.
DEMO_MODE=true
DATABASE_URL=sqlite:////var/www/stickercontrol-demo/data/demo.db
CORS_ORIGINS=https://stickercontrol-demo.roura.com.ar
# python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
SESSION_COOKIE_SECURE=true
# Sin Google en la demo: GOOGLE_CLIENT_ID queda vacio a proposito.
GOOGLE_CLIENT_ID=
DEMO_SESSION_TTL_HOURS=6
DEMO_MAX_SANDBOXES=300
DEMO_MAX_QUANTITY=20
DEMO_MAX_NOTES_LENGTH=280
DEMO_LOGIN_RATE_LIMIT=10
DEMO_LOGIN_RATE_WINDOW_SECONDS=600
